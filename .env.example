# Gemini MCP Server — environment variables
# These are set by gemini-wrapper.sh from macOS Keychain at runtime.
# Only needed if running the server directly (not via the wrapper).

# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — OpenRouter key for nano-banana-pro (Gemini 3 Pro Image, higher quality)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional — output directory for generated images (default: ~/Pictures/gemini-output)
OUTPUT_DIR=/path/to/your/output/directory

# Optional — set false to restrict file reads to ALLOWED_DIRS (recommended for forks)
ALLOW_UNRESTRICTED_FILE_ACCESS=true

# Optional — colon-separated list of allowed dirs when ALLOW_UNRESTRICTED_FILE_ACCESS=false
ALLOWED_DIRS=/Users/you/Pictures:/Users/you/Documents

# Optional — debug logging
DEBUG=false
DEBUG_ADVANCED_IMAGE=false
